  "components": [
    {
      "name": "Primary Start",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one cinnabar action per tool, in the transport dock.",
      "html": "<button class=\"ds-btn-primary\"><svg class=\"ds-ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5.5v13l10.5-6.5z\"/></svg>Start</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;min-height:46px;min-width:132px;padding:0 20px;border:0;border-radius:12px;background:var(--terracotta,#c43d24);color:var(--on-accent,#fff7ea);font-family:var(--font-text),Commissioner,sans-serif;font-size:15px;font-weight:700;letter-spacing:.02em;cursor:pointer;transition:background .12s}.ds-btn-primary:hover{background:var(--terracotta-hover,#a8321c)}.ds-btn-primary:focus-visible{outline:2px solid #efe6d2;outline-offset:2px}.ds-btn-primary:active{transform:scale(.98)}.ds-ico{width:1em;height:1em;fill:currentColor}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every non-primary action: a hairline pill in parchment.",
      "html": "<button class=\"ds-btn-secondary\">Coach</button>",
      "css": ".ds-btn-secondary{height:38px;padding:0 15px;border:1px solid rgba(239,230,210,.24);border-radius:999px;background:transparent;color:#efe6d2;font-family:Commissioner,sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background .12s,border-color .12s}.ds-btn-secondary:hover{background:#281f18}.ds-btn-secondary:focus-visible{outline:2px solid #efe6d2;outline-offset:2px}"
    },
    {
      "name": "Context Chip",
      "kind": "chip",
      "refersTo": "context-chip",
      "description": "Top-bar chip: small field label beside its value.",
      "html": "<button class=\"ds-chip\"><small>Dromos</small><b>Hijaz</b></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 13px;border:1px solid rgba(239,230,210,.12);border-radius:999px;background:#281f18;color:#efe6d2;font-family:Commissioner,sans-serif;cursor:pointer}.ds-chip small{color:rgba(239,230,210,.64);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.ds-chip b{font-weight:600}.ds-chip:hover{border-color:rgba(239,230,210,.24)}.ds-chip:focus-visible{outline:2px solid #efe6d2;outline-offset:2px}"
    },
    {
      "name": "Option Pills",
      "kind": "chip",
      "refersTo": "option-pill",
      "description": "One row of options above the neck; selection is parchment on ink.",
      "html": "<div class=\"ds-pills\"><button class=\"ds-pill ds-on\">D Hijaz · two tetrachords</button><button class=\"ds-pill\">D dominant pentatonic</button></div>",
      "css": ".ds-pills{display:flex;gap:6px;flex-wrap:wrap}.ds-pill{display:inline-flex;align-items:center;min-height:34px;padding:5px 12px;border:1px solid rgba(239,230,210,.12);border-radius:999px;background:transparent;color:rgba(239,230,210,.64);font-family:Commissioner,sans-serif;font-size:12px;font-weight:500;cursor:pointer;transition:color .12s,border-color .12s}.ds-pill:hover{color:#efe6d2;border-color:rgba(239,230,210,.24)}.ds-pill.ds-on{background:#efe6d2;color:#16110d;border-color:#efe6d2;font-weight:600}.ds-pill:focus-visible{outline:2px solid #efe6d2;outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Mode tabs and subdivision choices; active segment is parchment.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-active\">Guided plan</button><button>Phrase workbench</button><button>Rhythm comp</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;background:#1e1712;border:1px solid rgba(239,230,210,.12);border-radius:10px}.ds-seg button{min-height:34px;padding:0 16px;border:0;border-radius:7px;background:transparent;color:rgba(239,230,210,.8);font-family:Commissioner,sans-serif;font-size:13px;font-weight:500;cursor:pointer}.ds-seg button:hover{color:#efe6d2}.ds-seg button.ds-active{background:#efe6d2;color:#16110d;font-weight:600}.ds-seg button:focus-visible{outline:2px solid #efe6d2;outline-offset:2px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Desktop rail grouped by job; active entry is ink, never red.",
      "html": "<nav class=\"ds-rail\"><span class=\"ds-brand\">Δρόμος</span><a class=\"ds-today\">Today</a><span class=\"ds-group\">Practise</span><a class=\"ds-item ds-active\">Picking</a><a class=\"ds-item\">Solo</a><a class=\"ds-item\">Changes gym</a></nav>",
      "css": ".ds-rail{display:grid;gap:1px;width:200px;padding:22px 12px;background:#1a140f;font-family:Commissioner,sans-serif}.ds-brand{padding:0 10px 18px;font-family:'GFS Didot',Didot,Georgia,serif;font-size:26px;color:#efe6d2}.ds-group{padding:14px 10px 4px;color:rgba(239,230,210,.64);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.ds-item,.ds-today{display:block;padding:7px 10px;border-radius:8px;color:rgba(239,230,210,.8);font-size:14px;font-weight:500;cursor:pointer}.ds-today{font-weight:600}.ds-item:hover,.ds-today:hover{background:#281f18;color:#efe6d2}.ds-item.ds-active{background:#281f18;color:#efe6d2;font-weight:600;box-shadow:inset 0 0 0 1px rgba(239,230,210,.24)}"
    },
    {
      "name": "Now and Next Cards",
      "kind": "card",
      "refersTo": "card-now",
      "description": "Now in cinnabar wash, next as a dashed ink outline.",
      "html": "<div class=\"ds-pnow\"><div class=\"ds-cell ds-now\"><span>Start with</span><b>Ta · downstroke</b></div><div class=\"ds-cell ds-next\"><span>Next</span><b>Ka · upstroke</b></div></div>",
      "css": ".ds-pnow{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-family:Commissioner,sans-serif}.ds-cell{display:flex;align-items:baseline;gap:10px;padding:12px 16px;border-radius:12px;color:#efe6d2}.ds-cell span{font-size:12px;font-weight:600}.ds-cell b{font-size:16px}.ds-now{background:rgba(214,69,43,.16);border:1px solid #c43d24}.ds-now span{color:#e8644a}.ds-next{background:transparent;border:1px dashed rgba(239,230,210,.24)}.ds-next span{color:rgba(239,230,210,.8)}"
    },
    {
      "name": "Martyria",
      "kind": "custom",
      "refersTo": "martyria",
      "description": "The witness sign naming the dromos and tonic at the head of every neck.",
      "html": "<div class=\"ds-martyria\" aria-label=\"Dromos: Hijaz on D\"><span class=\"ds-echos\">Ήχος</span><span class=\"ds-name\">Χιτζάζ</span><span class=\"ds-tonic\">Ρε · Hijaz on D</span></div>",
      "css": ".ds-martyria{position:relative;display:inline-grid;justify-items:center;gap:2px;min-width:92px;padding:9px 10px 11px;border:1px solid rgba(214,69,43,.7);border-radius:3px;background:#1e1712;color:#e8644a;font-family:'GFS Didot',Didot,Georgia,serif;text-align:center;animation:ds-ink 520ms cubic-bezier(.16,1,.3,1)}.ds-martyria::after{content:'';position:absolute;left:50%;bottom:-9px;width:26px;height:1px;margin-left:-13px;background:#e8644a}.ds-echos{font-size:14px;line-height:1}.ds-name{font-size:19px;line-height:1.1}.ds-tonic{font-family:Commissioner,sans-serif;font-size:12px;color:rgba(239,230,210,.8)}@keyframes ds-ink{from{opacity:.15;filter:blur(3px);transform:translateY(3px)}to{opacity:1;filter:none;transform:none}}@media (prefers-reduced-motion:reduce){.ds-martyria{animation:none}}"
    },
    {
      "name": "Ink Neck Notes",
      "kind": "custom",
      "refersTo": "panel",
      "description": "The neck's vocabulary: tetrachord pigments, gold tonic, one cinnabar ring.",
      "html": "<svg class=\"ds-neck\" viewBox=\"0 0 260 60\" aria-hidden=\"true\"><rect width=\"260\" height=\"60\" rx=\"8\" fill=\"#281f18\"/><rect x=\"0\" y=\"29\" width=\"260\" height=\"1.4\" fill=\"rgba(239,230,210,.72)\"/><circle cx=\"35\" cy=\"30\" r=\"11\" fill=\"#c9a24a\"/><circle cx=\"85\" cy=\"30\" r=\"11\" fill=\"#7b9fc9\" stroke=\"#efe6d2\" stroke-width=\"2\"/><circle cx=\"85\" cy=\"30\" r=\"16\" fill=\"none\" stroke=\"#e8644a\" stroke-width=\"2\"/><circle cx=\"145\" cy=\"30\" r=\"11\" fill=\"#8fb07a\"/><circle cx=\"205\" cy=\"30\" r=\"11\" fill=\"rgba(239,230,210,.14)\"/><circle cx=\"205\" cy=\"30\" r=\"15\" fill=\"none\" stroke=\"#e0553a\" stroke-width=\"1.4\"/></svg>",
      "css": ".ds-neck{width:260px;height:60px;display:block}"
    }
  ],
  "narrative": {
    "northStar": "The Psaltic Manuscript",
    "overview": "Dromos reads like a Byzantine chant book laid open beside the instrument. The ground is iron-gall ink, the text is parchment, and before every line of music the mode is stated in red: the martyria, a small cinnabar cartouche reading Ήχος, the dromos in Greek, and its tonic, sits at the head of every neck. Then the line is played. The whole interface exists to get the player from \"which tool\" to \"the neck and the next note\" with nothing in between.\n\nThe chrome is deliberately quiet so the neck can be loud. Panels sit one tonal step above the ground and are separated by hairlines, not shadows. The rail and the top bar use parchment and an ink grey only. Colour is spent on the instrument: cinnabar for the note being played, gold for the tonic, and two muted pigments (lapis and verdigris) that show the lower and upper tetrachord of the dromos on the neck and the tab. Didot carries the voice of the book (tool titles, the drill name, the martyria); Commissioner carries every control and every number, in tabular figures.\n\nThe density is that of a practice book read at music-stand distance for an hour or more: one row of option pills, the neck at full width, the now and next cards and the tab strip under it, and a dock with one cinnabar Start. Explanation waits behind the Coach drawer; no paragraph sits above the neck. The contract named cinnabar as #d6452b; the build settled on a deeper #c43d24 fill with #e8644a for text and rings, and #d6452b survives only as the base of the cinnabar wash.",
